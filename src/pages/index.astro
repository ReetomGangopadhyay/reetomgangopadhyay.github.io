---
import { existsSync } from 'node:fs';
import Layout from '../layouts/BaseLayout.astro';

const cv = existsSync('public/Reetom_Gangopadhyay_CV.pdf');
const currentWork = [
  ['defcon', 'defcon', 'Packaging a tool that turns HPC batch scripts into editable container definitions.'],
  ['hawkeye', 'Hawkeye', 'Using Bayesian optimization to choose experiments that reveal performance bottlenecks on computing clusters.'],
  ['temporal-eos', 'Temporal EOS', 'Exploring whether dependence between training examples changes how neural networks behave near the edge of stability.'],
  ['leash', 'LEASH', 'Checking outgoing tool calls for sensitive information that a language model agent might accidentally disclose.'],
];
---
<Layout>
  <div class="profile">
    <section class="profile-intro">
      <h1>Reetom Gangopadhyay</h1>
      <div class="contact-links">
        <span>reetomjay [at] gmail [dot] com</span>
        <a href="https://github.com/ReetomGangopadhyay" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/reetom" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://orcid.org/0009-0003-8948-6309" target="_blank" rel="noopener noreferrer">ORCID</a>
        {cv && <a href="/Reetom_Gangopadhyay_CV.pdf" target="_blank" rel="noopener noreferrer">CV</a>}
      </div>
      <img class="portrait" src="/images/reetom-portrait.jpg" width="4000" height="6000" alt="Portrait of Reetom Gangopadhyay" />
      <p>I'm pursuing an M.S. in Data Science at Boston University, doing research and building software for BU Research Computing Services.</p>
      <p>My research spans statistical machine learning, deep learning, and high-performance computing. I'm interested in how models learn from data, how their assumptions affect what they discover, and how we can make them more reliable. My recent work includes Bayesian nonparametrics, neural network optimization, and autonomous AI agents.</p>
      <p>Outside of research, I play <a href="/piano/">classical piano</a>.</p>
      <p>If you have a project I might be interested in or questions about my work, feel free to reach out.</p>
    </section>
    <section class="current-work">
      <h2>Currently working on</h2>
      {currentWork.map(([id, title, description]) => (
        <article>
          <h3><a href={'/projects/#' + id}>{title}</a></h3>
          <p>{description}</p>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .profile-intro {
    display: flow-root;
  }

  .portrait {
    float: right;
    width: clamp(165px, 19vw, 205px);
    height: auto;
    margin: 0 0 14px 32px;
    border-radius: 4px;
  }

  @media (max-width: 620px) {
    .portrait {
      float: none;
      width: 156px;
      margin: 0 0 22px;
    }
  }
</style>
