---
import Layout from '../layouts/BaseLayout.astro';
import Intro from '../components/PageIntro.astro';
import Entry from '../components/PublicationEntry.astro';
import { publications } from '../data/publications';
const groups=[...new Set(publications.map(p=>p.group))];
---
<Layout title="Publications - reetom" description="Peer-reviewed publications, conference posters, and research in progress by Reetom Gangopadhyay and collaborators."><Intro title="Publications"/><div class="page-grid"><aside>{groups.map((g,i)=><a href={'#group-'+i}>{g}</a>)}</aside><div>{groups.map((g,i)=><section class="entry" id={'group-'+i}><h2>{g}</h2>{publications.filter(p=>p.group===g).map(p=><Entry paper={p}/>)}</section>)}</div></div></Layout>
